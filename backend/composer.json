{
  "name": "prosperya/site-api",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-mongodb": "^2.5",
    "laravel/framework": "^12.0",
    "mongodb/laravel-mongodb": "^5.7",
    "mongodb/mongodb": "^2.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "*"
      ]
    }
  }
}
