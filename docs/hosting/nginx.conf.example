# Replace the domain, checkout paths and PHP-FPM socket for the deployment.
server {
    listen 80;
    server_name your-confirmed-domain.example;
    root /srv/prosperya-site/backend/public;
    index index.php;

    location /assets/ {
        root /srv/prosperya-site/frontend/dist;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /images/ {
        root /srv/prosperya-site/frontend/dist;
        try_files $uri =404;
        expires 1h;
    }

    location ~ ^/[^/]+\.(?:ico|svg|png|webp|webmanifest)$ {
        root /srv/prosperya-site/frontend/dist;
        try_files $uri =404;
    }

    # All HTML and SEO responses come from Laravel.
    location / {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
    }

    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
